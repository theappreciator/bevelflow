{
  "name": "bevelflow",
  "version": "0.3.0",
  "description": "Bevelflow PWA",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "generate-icons": "pwa-assets-generator",
    "dev:api": "wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply bevelflow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bevelflow-db --remote"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theappreciator/bevelflow.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/theappreciator/bevelflow/issues"
  },
  "homepage": "https://github.com/theappreciator/bevelflow#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "jose": "^6.2.15"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true,
    "esbuild@0.28.2": true
  }
}
